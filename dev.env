# Web
NEXT_PUBLIC_LEARNHOUSE_API_URL=http://localhost:1338/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BASE_URL=http://localhost:3000
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_BASE_TOP_DOMAIN=localhost
NEXT_PUBLIC_LEARNHOUSE_MEDIA_URL=http://localhost:1338/
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:3001
NEXT_PUBLIC_LSP_WS_URL=ws://localhost:3011
NEXTAUTH_SECRET=

# Public development-only database defaults. Override these in dev.local.env.
POSTGRES_PASSWORD=local-development-only-db-password
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:local-development-only-db-password@localhost:5432/learnhouse
KEYCLOAK_ADMIN_PASSWORD=local-development-only-keycloak-password

# Keycloak
LEARNHOUSE_KEYCLOAK_ISSUER=http://localhost:8081/realms/learnhouse
LEARNHOUSE_KEYCLOAK_CLIENT_ID=learnhouse-web
LEARNHOUSE_KEYCLOAK_CLIENT_SECRET=
LEARNHOUSE_KEYCLOAK_ID_TOKEN_ALG=RS512

# Backend defaults
LEARNHOUSE_DEFAULT_ORG_SLUG=default
LOG_LEVEL=DEBUG
SQLALCHEMY_LOG_LEVEL=WARNING
SHARED_COLLAB_JWT_SECRET=
LEARNHOUSE_SELF_HOSTED=true
LEARNHOUSE_AI_PROVIDER=self_hosted
LEARNHOUSE_AI_API_KEY=
LEARNHOUSE_AI_BASE_URL=http://172.20.9.12:8000/v1
LEARNHOUSE_WORKSPACE_DEV_MODE=true
LEARNHOUSE_WORKSPACE_REDIS_URL=redis://localhost:6379/0
LEARNHOUSE_WORKSPACE_COLLAB_BRIDGE_URL=http://localhost:3001
LEARNHOUSE_WORKSPACE_SHARED_COLLAB_JWT_SECRET=
LEARNHOUSE_AI_TEXT_EVAL_MODEL=QwQ-32B-Reasoning
LEARNHOUSE_AI_GRADING_CRITERIA_MODEL=QwQ-32B-Reasoning
LEARNHOUSE_AI_TIMEOUT_SEC=60
LEARNHOUSE_WORKSPACE_ANALYTICS_HOST=
LEARNHOUSE_WORKSPACE_ANALYTICS_API_KEY=
LEARNHOUSE_WORKSPACE_JUDGE0_BASE_URL=
LEARNHOUSE_WORKSPACE_JUDGE0_TOKEN=
LEARNHOUSE_WORKSPACE_JUDGE0_WEBHOOK_SECRET=
LEARNHOUSE_WORKSPACE_MATHPIX_API_KEY=
LEARNHOUSE_WORKSPACE_MATHPIX_APP_ID=
